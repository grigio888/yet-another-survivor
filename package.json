		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@capacitor/android": "8.3.4",
		"@capacitor/cli": "^8.3.4",
		"@capacitor/core": "^8.3.4",
		"@capacitor/ios": "8.3.4"
	}
